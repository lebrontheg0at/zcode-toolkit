{
  "description": "ZCode Toolkit auto-repatch hook: re-applies the app.asar patch and agent-runtime sanitizer after ZCode updates.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\Saber\\.zcode\\workspace\\default\\zcode-tokmeter\\asar-patch\\session-start.ps1\""
          }
        ]
      }
    ]
  }
}
